# M1 reads WA_*, DATABASE_URL, WEBHOOK_PATH, ADMIN_API_KEY, and LOG_SALT.
# Worker, outbound, and handoff options below are planned for later milestones.
WA_PHONE_ID=
WA_TOKEN=
WA_APP_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_WABA_ID=
WA_CALLBACK_URL=
WEBHOOK_PATH=/webhook
DATABASE_URL=sqlite+aiosqlite:///./wagent.db
ADMIN_API_KEY=
LOG_SALT=
DEBOUNCE_MS=1500
MAX_DEBOUNCE_MS=5000
LEASE_SECONDS=120
RUNNER_TIMEOUT_SECONDS=60
MAX_ATTEMPTS=3
RATE_LIMIT_TURNS_PER_MIN=6
DAILY_OUTBOUND_CAP_PER_USER=50
OUT_OF_WINDOW_POLICY=drop
FALLBACK_TEMPLATE_NAME=
FALLBACK_TEMPLATE_LANG=
OPT_OUT_KEYWORDS=STOP,UNSUBSCRIBE
HANDOFF_KEYWORDS=
HANDOFF_WEBHOOK_URL=
MARK_AS_READ=true
RETENTION_DAYS=30
PAUSE_ALL=false
