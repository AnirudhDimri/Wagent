# M4 adds batching, limits, pause, opt-out, retention, and erasure.
# Human handoff hooks and MARK_AS_READ remain for later milestones.
WA_PHONE_ID=
WA_TOKEN=
WA_APP_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_WABA_ID=
WA_API_VERSION=v26.0
WA_CALLBACK_URL=
WEBHOOK_PATH=/webhook
DATABASE_URL=sqlite+aiosqlite:///./wagent.db
ADMIN_API_KEY=
LOG_SALT=
DEBOUNCE_MS=1500
MAX_DEBOUNCE_MS=5000
LEASE_SECONDS=120
RUNNER_TIMEOUT_SECONDS=60
SEND_TIMEOUT_SECONDS=20
SEND_MAX_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=1
WORKER_POLL_SECONDS=0.1
WORKER_CONCURRENCY=8
MAX_ATTEMPTS=3
RATE_LIMIT_TURNS_PER_MIN=6
DAILY_OUTBOUND_CAP_PER_USER=50
OUT_OF_WINDOW_POLICY=drop
FALLBACK_TEMPLATE_NAME=
FALLBACK_TEMPLATE_LANG=en_US
OPT_OUT_KEYWORDS=STOP,UNSUBSCRIBE
HANDOFF_KEYWORDS=
HANDOFF_WEBHOOK_URL=
MARK_AS_READ=true
RETENTION_DAYS=30
RETENTION_INTERVAL_SECONDS=3600
PAUSE_ALL=false
